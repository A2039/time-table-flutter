# Example Environment Configuration for Time Table App
#
# Use these variables with --dart-define during build/run:
# flutter run --dart-define=API_BASE_URL=... --dart-define=API_TOKEN=...

# Deployed Google Apps Script Web App URL ending with /exec
API_BASE_URL="https://script.google.com/macros/s/AKfycbx_YOUR_DEPLOYMENT_ID_HERE/exec"

# User API token configured in backend Script Properties (API_TOKEN)
# Note: For production use, enter this via the app Settings screen where it is stored in secure storage.
API_TOKEN="your_personal_api_token_here"

# Application Environment: 'development', 'staging', 'production'
APP_ENV="development"

# Feature Flag: Enable Admin Database Diagnostics screen (default: false)
ENABLE_ADMIN="false"
